# Claude Code -> local sf collector (http/json on 127.0.0.1:4318). Load before starting claude:
#   set -a; source profiles/otel.env; set +a        (or: eval "$(uv run sf otel env)")
CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Without this, non-official plugin and skill names are redacted to "third-party".
# It also adds tool parameters to the logs, which is why the collector only listens on 127.0.0.1.
OTEL_LOG_TOOL_DETAILS=1
